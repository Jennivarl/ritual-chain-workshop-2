# Copy to web/.env.local

# Printed by hardhat/scripts/deploy.ts
NEXT_PUBLIC_PREDICT_ADDRESS=0x

# Chain. Defaults match Ritual Chain testnet.
NEXT_PUBLIC_RITUAL_CHAIN_ID=1979
NEXT_PUBLIC_RITUAL_RPC_URL=https://rpc.ritualfoundation.org

# The oracle URL baked into new markets. The TEE executor calls this from the
# public internet, so localhost will NOT work - expose it with a tunnel first:
#   cloudflared tunnel --url http://localhost:3000
NEXT_PUBLIC_DEMO_ORACLE_URL=https://your-tunnel.example/api/oracle/eth

# Price the bundled demo oracle reports when nothing has overridden it.
DEMO_ORACLE_PRICE=4123

# Optional: adds a WalletConnect connector when set.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
